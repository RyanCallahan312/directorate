{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "target": "ESNext",
    "lib": ["ESNext"],
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedExperimentalApis": ["effect/encoding/Zip"],
        "allowedUnstableApis": [
          "effect/ByteSize#toNumber",
          "effect/Bytes",
          "effect/FileSystem",
          "effect/Path",
          "effect/crypto",
          "effect/PlatformError",
          "effect/encoding/Yaml",
          "effect/process",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/platform-node-shared/NodeChildProcessSpawner",
          "@effect/platform-node-shared/NodeCrypto"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
