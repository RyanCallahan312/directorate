  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanCallahan312/directorate.git",
    "directory": "packages/opencode-directorate"
  },
  "files": [
    "src",
    "!src/AGENTS.md",
    "dist/gui-experimental.cjs",
