{
  "name": "directorate",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "ultracite check --max-warnings 0",
    "format": "ultracite fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test --continue=dependencies-successful",
    "check:effect-skill": "bun .agents/skills/effect-ts/scripts/check-links.ts && bun .agents/skills/effect-ts/scripts/verify-apis.ts && bun .agents/skills/effect-ts/scripts/typecheck-examples.ts && bun test ./.agents/skills/effect-ts/scripts/scripts.test.ts",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.67.5",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^26.6.5",
    "effect": "4.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "turbo": "^2.11.8",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14"
}
